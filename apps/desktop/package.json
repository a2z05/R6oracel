{
  "name": "@oracle/desktop",
  "version": "1.0.4",
  "description": "Premium tactical companion for Rainbow Six Siege",
  "author": "a2z05",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npx electron-vite build",
    "preview": "electron-vite preview",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build && electron-builder --win --publish always",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oracle/db": "*",
    "@oracle/domain": "*",
    "@oracle/ocr": "*",
    "@oracle/overlay": "*",
    "@oracle/providers": "*",
    "@oracle/shared": "*",
    "@oracle/ui-tokens": "*",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "express": "^4.21.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^5.1.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "7zip-bin": "^5.2.0",
    "electron": "33.4.11",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
